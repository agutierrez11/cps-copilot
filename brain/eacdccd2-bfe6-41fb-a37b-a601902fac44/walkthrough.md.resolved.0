===
# Configuración mínima absoluta
project:
  name: "Ecosistema Fintech"

# IMPORTANTE: En Windows, a veces necesita la ruta completa o "./"
entry: "../"

# Forzamos a que ignore carpetas de sistema que podrían causar conflictos
exclude:
  - .obsidian
  - node_modules
```
